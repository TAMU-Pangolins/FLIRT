# Puts FLIRT's programs (and compare, when <build>-compare exists) on PATH,
# for this shell session only. Use in bash or zsh: source <build>/env.sh
# (tcsh: source <build>/env.csh). Sourcing it again adds nothing twice.
_flirt_env_bin='@FLIRT_ENV_BIN@'
_flirt_env_compare='@FLIRT_ENV_COMPARE@'
if [ -d "$_flirt_env_compare" ]; then
    case ":${PATH:-}:" in
        *":$_flirt_env_compare:"*) ;;
        *) PATH="$_flirt_env_compare${PATH:+:$PATH}" ;;
    esac
fi
case ":${PATH:-}:" in
    *":$_flirt_env_bin:"*) ;;
    *) PATH="$_flirt_env_bin${PATH:+:$PATH}" ;;
esac
export PATH
unset _flirt_env_bin _flirt_env_compare
