# Puts FLIRT's programs (and compare, when <build>-compare exists) on PATH,
# for this shell session only. Use in tcsh: source <build>/env.csh
# (bash, zsh: source <build>/env.sh). Sourcing it again adds nothing twice.
set _flirt_env_bin='@FLIRT_ENV_BIN@'
set _flirt_env_compare='@FLIRT_ENV_COMPARE@'
if ( ! $?PATH ) setenv PATH ''
if ( -d "$_flirt_env_compare" ) then
    if ( ":${PATH}:" !~ *":${_flirt_env_compare}:"* ) then
        if ( "$PATH" == '' ) then
            setenv PATH "${_flirt_env_compare}"
        else
            setenv PATH "${_flirt_env_compare}:${PATH}"
        endif
    endif
endif
if ( ":${PATH}:" !~ *":${_flirt_env_bin}:"* ) then
    if ( "$PATH" == '' ) then
        setenv PATH "${_flirt_env_bin}"
    else
        setenv PATH "${_flirt_env_bin}:${PATH}"
    endif
endif
unset _flirt_env_bin _flirt_env_compare
rehash
